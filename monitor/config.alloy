logging {
  level  = "info"
  format = "logfmt"
}

discovery.docker "ploud" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"

  filter {
    name = "label"
    values = [
      "com.docker.compose.service=ploud",
    ]
  }
}

discovery.relabel "ploud_logs" {
  targets = []

  rule {
    source_labels = [
      "__meta_docker_container_label_com_docker_compose_service",
    ]
    target_label = "service_name"
  }

  rule {
    source_labels = [
      "__meta_docker_container_name",
    ]
    regex        = "/(.*)"
    target_label = "container"
  }

  rule {
    source_labels = [
      "__meta_docker_container_label_com_docker_compose_project",
    ]
    target_label = "compose_project"
  }
}

loki.source.docker "ploud" {
  host    = "unix:///var/run/docker.sock"
  targets = discovery.docker.ploud.targets

  labels = {
    platform    = "docker",
    environment = "prod",
  }

  relabel_rules = discovery.relabel.ploud_logs.rules
  forward_to    = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
